+/// Where `pos` is on screen (the top of a caret there) and the line's height.
+pub fn pos_screen(app: &mut WordApp, pos: &Pos) -> Option<(Pos2, f32)> {
+    let l = app.session.layout();
+    let c = l.caret_on(pos, app.session.page_hint)?;
+    let p = page_to_screen(app, c.page, c.x, c.top)?;
+    let scale = app
+        .canvas
+        .page_rects
+        .get(c.page)
+        .and_then(|r| l.pages.get(c.page).map(|page| page_screen_scale(*r, page, app.canvas.scale)))
+        .unwrap_or(app.canvas.scale);
+    Some((p, c.height * scale))
+}
+
