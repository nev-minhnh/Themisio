+    /// The band's first and last column, worked out once after each change.
+    #[serde(skip)]
+    cols: std::sync::OnceLock<Option<(u32, u32)>>,
+}
+
+impl PartialEq for Band {
+    fn eq(&self, other: &Self) -> bool {
+        self.rows == other.rows
+    }
+}
+
+impl Band {
+    fn col_bounds(&self) -> Option<(u32, u32)> {
+        *self.cols.get_or_init(|| {
+            let mut out: Option<(u32, u32)> = None;
+            for cols in self.rows.values() {
+                if let (Some(a), Some(b)) = (cols.keys().next(), cols.keys().next_back()) {
+                    out = Some(out.map_or((*a, *b), |(x, y)| (x.min(*a), y.max(*b))));
+                }
+            }
+            out
+        })
+    }
 }
 
